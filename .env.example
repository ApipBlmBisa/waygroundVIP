# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL / SUPABASE_SERVICE_KEY: optional but recommended.
# If both are set, the app stores its database (users, leaderboard, history)
# in Supabase Postgres instead of a local JSON file, so data survives
# redeploys and the free-tier "sleep" cycle on hosts like Render.
# Get these from your Supabase project: Settings > API.
# Use the "service_role" key (not the public anon key) since the server
# writes data on behalf of all users.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
